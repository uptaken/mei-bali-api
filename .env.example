APP_NAME="Mei Bali Ops API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Email notifications (use SMTP in production; log is suitable for local development)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mei_bali_ops
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# Alamat frontend: dipakai untuk tautan di email (login, buat/reset kata sandi) dan izin CORS.
# Frontend origin(s) allowed to call this API with cookies/credentials (comma separated).
SANCTUM_STATEFUL_DOMAINS=localhost:5199,127.0.0.1:5199
FRONTEND_URL=http://localhost:5199

# --- Company details printed on PDFs (leave a line empty to leave it off) ---
COMPANY_NAME="Mei Bali"
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_BANK_ACCOUNT=

# --- WhatsApp: gateway self-hosted ---
# Alamat gateway dan ID sesi yang dipakai. Dipakai halaman Template WhatsApp (scan QR) dan pengiriman
# pesan konfirmasi ke supplier. Kosong = fitur WhatsApp tidak aktif (QR mengembalikan 503).
WA_URL=
WA_SESSION_ID=

# --- PDF (itinerary, invoice, laporan) ---
# Dibuat lewat Browsershot, jadi server butuh Node.js, paket npm "puppeteer", dan Chrome/Chromium.
# Isi hanya bila lokasinya tidak ditemukan otomatis.
LARAVEL_PDF_NODE_BINARY=
LARAVEL_PDF_CHROME_PATH=

# --- Email ---
# Registrasi, ganti password/profil, dan lupa password dikirim lewat MAIL_* di atas.
# Di production ganti MAIL_MAILER=log dengan smtp dan isi host/port/username/password.
# Pesan WhatsApp dan email dikirim lewat antrean: jalankan "php artisan queue:work" (QUEUE_CONNECTION=database).
